{
    "name": "digipolisgent/syslog-bundle",
    "description": "Configures the symfony (monolog) syslog logger to output in a format that kibana can parse.",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.3",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/monolog-bundle": "^3.7",
        "symfony/security-core": "^6.4 || ^7.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Jelle Sebreghts",
            "email": "sebreghts.jelle@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "DigipolisGent\\SyslogBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DigipolisGent\\SyslogBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0"
    }
}
